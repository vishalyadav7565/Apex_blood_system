      summary: Register a new Ambulance
      tags:
      - Ambulance Management
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AmbulanceRegisterRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AmbulanceRegisterRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AmbulanceRegisterRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ambulance'
          description: ''
