  /api/ambulance/{id}/:
    get:
      operationId: api_ambulance_retrieve
      description: Manage an individual ambulance record by ID.
      summary: Retrieve, Update or Delete an Ambulance
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Ambulance Management
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ambulance'
          description: ''
        '204':
          description: Deleted successfully
        '404':
          description: Ambulance record not found
    put:
      operationId: api_ambulance_update
      description: Manage an individual ambulance record by ID.
      summary: Retrieve, Update or Delete an Ambulance
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Ambulance Management
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AmbulanceRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AmbulanceRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AmbulanceRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ambulance'
          description: ''
        '204':
          description: Deleted successfully
        '404':
          description: Ambulance record not found
    patch:
      operationId: api_ambulance_partial_update
      description: Manage an individual ambulance record by ID.
      summary: Retrieve, Update or Delete an Ambulance
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Ambulance Management
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAmbulanceRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAmbulanceRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAmbulanceRequest'
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ambulance'
          description: ''
        '204':
          description: Deleted successfully
        '404':
          description: Ambulance record not found
    delete:
      operationId: api_ambulance_destroy
      description: Manage an individual ambulance record by ID.
      summary: Retrieve, Update or Delete an Ambulance
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Ambulance Management
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ambulance'
          description: ''
        '204':
          description: Deleted successfully
        '404':
          description: Ambulance record not found
