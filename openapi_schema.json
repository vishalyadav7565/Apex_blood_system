components:
  schemas:
    Ambulance:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        vehicle_number:
          type: string
          maxLength: 50
        ambulance_type:
          $ref: '#/components/schemas/AmbulanceTypeEnum'
        registration_number:
          type: string
          maxLength: 50
        owner:
          allOf:
          - $ref: '#/components/schemas/Owner'
          readOnly: true
        hospital:
          allOf:
          - $ref: '#/components/schemas/Hospital'
          readOnly: true
        is_active:
          type: boolean
        is_available:
          type: boolean
        status:
          $ref: '#/components/schemas/StatusEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - ambulance_type
      - created_at
      - hospital
      - id
      - owner
      - registration_number
      - updated_at
      - vehicle_number
    AmbulanceRegisterRequest:
      type: object
      properties:
        vehicle_number:
          type: string
          minLength: 1
          maxLength: 50
        ambulance_type:
          $ref: '#/components/schemas/AmbulanceTypeEnum'
        registration_number:
          type: string
          minLength: 1
          maxLength: 50
        owner_id:
          type: integer
          writeOnly: true
          nullable: true
        hospital_id:
          type: integer
          writeOnly: true
          nullable: true
        is_active:
          type: boolean
        is_available:
          type: boolean
        status:
          $ref: '#/components/schemas/StatusEnum'
      required:
      - ambulance_type
      - registration_number
      - vehicle_number
    AmbulanceRequest:
      type: object
      properties:
        vehicle_number:
          type: string
          minLength: 1
          maxLength: 50
        ambulance_type:
          $ref: '#/components/schemas/AmbulanceTypeEnum'
        registration_number:
          type: string
          minLength: 1
          maxLength: 50
        owner_id:
          type: integer
          writeOnly: true
          nullable: true
        hospital_id:
          type: integer
          writeOnly: true
          nullable: true
        is_active:
          type: boolean
        is_available:
          type: boolean
        status:
          $ref: '#/components/schemas/StatusEnum'
      required:
      - ambulance_type
      - registration_number
      - vehicle_number
    AmbulanceTypeEnum:
      enum:
      - BLS
      - ALS
      - ICU
      - Neonatal
      - Patient Transport
      type: string
      description: |-
        * `BLS` - BLS
        * `ALS` - ALS
        * `ICU` - ICU
        * `Neonatal` - Neonatal
        * `Patient Transport` - Patient Transport
    Hospital:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        email:
          nullable: true
          oneOf:
          - type: string
            format: email
            maxLength: 254
          - type: string
            maxLength: 0
        phone:
          type: string
          nullable: true
          maxLength: 15
        address:
          type: string
          nullable: true
        pincode:
          type: string
          nullable: true
          maxLength: 10
        latitude:
          type: number
          format: double
          nullable: true
        longitude:
          type: number
          format: double
          nullable: true
        is_verified:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        distance:
          type: string
          readOnly: true
      required:
      - created_at
      - distance
      - id
      - name
      - updated_at
    HospitalRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 100
        email:
          nullable: true
          oneOf:
          - type: string
            format: email
            maxLength: 254
          - type: string
            maxLength: 0
        phone:
          type: string
          nullable: true
          maxLength: 15
        address:
          type: string
          nullable: true
        pincode:
          type: string
          nullable: true
          maxLength: 10
        latitude:
          type: number
          format: double
          nullable: true
        longitude:
          type: number
          format: double
          nullable: true
        is_verified:
          type: boolean
      required:
      - name
    Owner:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 150
        email:
          type: string
          format: email
          maxLength: 254
        phone:
          type: string
          maxLength: 15
        company_name:
          type: string
          nullable: true
          maxLength: 150
        address:
          type: string
          nullable: true
        verification_status:
          allOf:
          - $ref: '#/components/schemas/VerificationStatusEnum'
          readOnly: true
        is_verified:
          type: boolean
          readOnly: true
        is_approved:
          type: string
          readOnly: true
        is_email_verified:
          type: boolean
          readOnly: true
        is_phone_verified:
          type: boolean
          readOnly: true
        is_aadhaar_verified:
          type: boolean
          readOnly: true
        is_business_doc_verified:
          type: boolean
        is_selfie_verified:
          type: boolean
        rejection_reason:
          type: string
          nullable: true
        digilocker_token:
          type: string
          nullable: true
          maxLength: 255
        aadhaar_number:
          type: string
          nullable: true
          maxLength: 20
        aadhaar_card:
          type: string
          format: uri
          nullable: true
        aadhaar_card_back:
          type: string
          format: uri
          nullable: true
        business_doc:
          type: string
          format: uri
          nullable: true
        selfie:
          type: string
          format: uri
          nullable: true
        face_match_score:
          type: number
          format: double
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - email
      - face_match_score
      - id
      - is_aadhaar_verified
      - is_approved
      - is_email_verified
      - is_phone_verified
      - is_verified
      - name
      - phone
      - updated_at
      - verification_status
    OwnerRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 150
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        phone:
          type: string
          minLength: 1
          maxLength: 15
        company_name:
          type: string
          nullable: true
          maxLength: 150
        address:
          type: string
          nullable: true
        is_business_doc_verified:
          type: boolean
        is_selfie_verified:
          type: boolean
        rejection_reason:
          type: string
          nullable: true
        digilocker_token:
          type: string
          nullable: true
          maxLength: 255
        aadhaar_number:
          type: string
          nullable: true
          maxLength: 20
        aadhaar_card:
          type: string
          format: binary
          nullable: true
        aadhaar_card_back:
          type: string
          format: binary
          nullable: true
        business_doc:
          type: string
          format: binary
          nullable: true
        selfie:
          type: string
          format: binary
          nullable: true
      required:
      - email
      - name
      - phone
    PatchedAmbulanceRequest:
      type: object
      properties:
        vehicle_number:
          type: string
          minLength: 1
          maxLength: 50
        ambulance_type:
          $ref: '#/components/schemas/AmbulanceTypeEnum'
        registration_number:
          type: string
          minLength: 1
          maxLength: 50
        owner_id:
          type: integer
          writeOnly: true
          nullable: true
        hospital_id:
          type: integer
          writeOnly: true
          nullable: true
        is_active:
          type: boolean
        is_available:
          type: boolean
        status:
          $ref: '#/components/schemas/StatusEnum'
    SendEmailOTPRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
      required:
      - email
    StatusEnum:
      enum:
      - offline
      - online
      - busy
      - maintenance
      type: string
      description: |-
        * `offline` - Offline
        * `online` - Online
        * `busy` - Busy
        * `maintenance` - Maintenance
    TokenObtainPair:
      type: object
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
          readOnly: true
      required:
      - access
      - refresh
    TokenObtainPairRequest:
      type: object
      properties:
        username:
          type: string
          writeOnly: true
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - password
      - username
    TokenRefresh:
      type: object
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
      required:
      - access
      - refresh
    TokenRefreshRequest:
      type: object
      properties:
        refresh:
          type: string
          minLength: 1
      required:
      - refresh
    VerificationStatusEnum:
      enum:
      - pending_verification
      - pending_admin_review
      - approved
      - rejected
      type: string
      description: |-
        * `pending_verification` - Pending Verification
        * `pending_admin_review` - Pending Admin Review
        * `approved` - Approved
        * `rejected` - Rejected
    VerifyEmailOTPRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        otp:
          type: string
          minLength: 1
          maxLength: 6
      required:
      - email
      - otp
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
